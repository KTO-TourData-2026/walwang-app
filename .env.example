# 네이버 클라우드 플랫폼 > Maps > Application 에서 발급받은 Client ID
# 이 값은 네이티브 빌드(prebuild) 시점에만 쓰이므로 EXPO_PUBLIC_ 접두사를 붙이지 않는다.
NAVER_MAP_CLIENT_ID=

# 백엔드 API 주소. 예: https://api.walwang.dev
# EXPO_PUBLIC_ 접두사가 있어야 JS 번들에 포함되어 앱 코드에서 읽을 수 있다.
# 값을 바꾼 뒤에는 Metro 캐시 때문에 `npx expo start -c` 로 재시작해야 반영된다.
EXPO_PUBLIC_API_BASE_URL=
